POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://factorypulse:replace-with-a-local-password@db:5432/factorypulse

VITE_API_BASE_URL=http://localhost:8000/api/v1

